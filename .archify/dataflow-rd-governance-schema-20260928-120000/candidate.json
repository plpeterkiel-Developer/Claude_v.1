  "cards": [
    {
      "dot": "cyan",
      "title": "Two halves: assessment → decision",
      "items": [
        "The document has exactly two required parts: 'assessment' (the answers) and 'decision' (the verdict)",
        "Assessment = core intake always asked (project, owners, data, access) plus triggered modules",
        "intakeTrace records which Q-### questions were answered and which M-* modules fired"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared building blocks ($defs)",
      "items": [
        "answer: YES / NO / POTENTIAL / UNKNOWN / NOT_APPLICABLE, reused by most questions",
        "identity: id + displayName (+ email), used for owners, reviews, evidence and audit",
        "review, evidence and riskAppetiteResult define the items in the decision lists"
      ]
    },
    {
      "dot": "rose",
      "title": "Decision outcome",
      "items": [
        "Risk is scored on three axes: security S1–S4, compliance C0–C3, access A1–A4, plus a hardStop flag",
        "status ranges from DRAFT and FAST_TRACK through CONDITIONAL_PROCEED and BLOCKED to APPROVED or RETIRED",
        "audit keeps a SHA-256 answersHash, applied rules, human approvals, overrides and change history"
      ]
    },
    {
      "dot": "amber",
      "title": "Reading the arrows",
      "items": [
        "The schema defines structure only; it does not contain the scoring rules",
        "Solid arrows show which inputs logically inform which decision fields",
        "Dashed arrows: core answers trigger optional modules, and every answer is logged in intakeTrace and hashed into audit. Which answer triggers which module is not specified in the schema"
      ]
    }
  ]
