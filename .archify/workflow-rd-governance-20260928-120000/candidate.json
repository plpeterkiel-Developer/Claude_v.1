  "cards": [
    {
      "dot": "rose",
      "title": "Decision precedence (worst wins)",
      "items": [
        "1 BLOCKED: any hard stop",
        "2 REVIEW_REQUIRED: pending review or material unknown",
        "3 CONDITIONAL_PROCEED: conditions outstanding",
        "4 FAST_TRACK: S1 + C0 + A1, complete inputs, evidence accepted",
        "5 APPROVED: all reviews approved, evidence accepted"
      ]
    },
    {
      "dot": "cyan",
      "title": "S / C / A tiers",
      "items": [
        "Security S1–S4: classification, sensitive data, privilege, external, AI actions",
        "Compliance C0–C3: personal data, GxP, patient safety, NIS2, AI approval",
        "Access A1–A4: A3/A4 need expiry, Data Owner approval, quarterly review"
      ]
    },
    {
      "dot": "violet",
      "title": "Authority boundaries",
      "items": [
        "Engine may: collect facts, calculate tiers, pick controls, route reviews",
        "Engine must not: approve Strictly Confidential, high-risk access, exceptions or regulated release",
        "UNKNOWN is never treated as NO"
      ]
    },
    {
      "dot": "amber",
      "title": "Adaptive intake targets",
      "items": [
        "80% of assessments ≤ 15 questions, 95% ≤ 30",
        "Low-risk internal 10–15 · AI + regulated + supplier 40–60",
        "Modules: Privacy, External/Supplier, Privileged, Restricted, Quality/Regulatory, AI, Development, Architecture"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stage gates",
      "items": [
        "Concept → Architecture → Development → Validation",
        "Production onboarding: all blockers closed, approvals, expiry, monitoring",
        "Operate → Retirement: access removed, identities retired"
      ]
    }
  ]
}